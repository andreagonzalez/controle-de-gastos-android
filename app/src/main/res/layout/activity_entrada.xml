<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastro de Entrada"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editDescricaoEntrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Descrição da entrada" />

    <EditText
        android:id="@+id/editValorEntrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor da entrada"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/btnAdicionarEntrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar Entrada" />

</LinearLayout>