<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saldo por Período"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/editDataInicial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Data inicial (dd/MM/yyyy)" />

    <EditText
        android:id="@+id/editDataFinal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Data final (dd/MM/yyyy)" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calcular" />

    <TextView
        android:id="@+id/textTotalEntradas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total de entradas: R$ 0,00"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/textTotalGastos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total de gastos: R$ 0,00" />

    <TextView
        android:id="@+id/textSaldoPeriodo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saldo do período: R$ 0,00"
        android:textSize="18sp" />

</LinearLayout>